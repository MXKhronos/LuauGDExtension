{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "scons target=editor dev_build=yes tests=true",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "run-extension-tests",
            "type": "shell",
            "command": "Y:/OpenSource/godot/bin/godot.windows.editor.dev.x86_64.console.exe --headless --path .\\demo -e -v --quit --run-extension-tests",
            "dependsOn": "build",
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "view-commits",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "git -C ${workspaceFolder} log -p --branches --not --remotes > \".\\.debug\\this_commits.diff\" && code \".\\.debug\\this_commits.diff\""
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
